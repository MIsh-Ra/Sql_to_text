# LLM Configuration
LLM_PROVIDER=groq # groq | gemini | openai
LLM_MODEL=openai/gpt-oss-120b

# API Keys (set the one matching your LLM_PROVIDER)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cache & Rate Limiting
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=./cache/llm_cache
LLM_CONCURRENCY=4
LLM_MAX_RETRIES=5

# Optional LangSmith Tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=text-to-sql-agent

